# Local hosted beta. Copy to a private environment file; never commit credentials.
# Node does not automatically load this file. Export variables or use your host's
# environment settings. Use HTTPS and NODE_ENV=production on Render.
GAMEFRAME_HOSTED=1
GAMEFRAME_DATA_DIR=./hosted-data
APP_ORIGIN=http://localhost:8000
AUTH_CODE_SECRET=
ADMIN_API_KEY=
AUTH_ALLOW_DEV_CODE=false
GAMEFRAME_ENFORCE_PRODUCTION_CONFIG=true
RESEND_API_KEY=
AUTH_FROM_EMAIL=
OPERATIONS_EMAIL=
SUPPORT_EMAIL=
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
GAMEFRAME_SALES_OPEN=false
GAMEFRAME_LEGAL_PUBLISHED=false
GAMEFRAME_SYNTHETIC_DB=./ev-predictor/data/hittrax_from_video.sqlite
GAMEFRAME_SYNTHETIC_SHA256=
GAMEFRAME_SYNTHETIC_URL=
GAMEFRAME_SYNTHETIC_REMOTE=gameframe:GameFrameBaseball/assets/hittrax.sqlite
RCLONE_CONFIG_GAMEFRAME_TYPE=b2
RCLONE_CONFIG_GAMEFRAME_ACCOUNT=
RCLONE_CONFIG_GAMEFRAME_KEY=
GAMEFRAME_DEMO_DB=./release-artifacts/approved-demo.db
BACKUP_DIRECTORY=./gameframe-backups
